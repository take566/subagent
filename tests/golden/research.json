{
  "serverInfo": {
    "name": "ResearchAgent",
    "version": "1.0.0"
  },
  "tools": [
    {
      "name": "web_search",
      "description": "Web検索を実行",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "required": true
          },
          "max_results": {
            "type": "number",
            "required": false
          }
        }
      }
    },
    {
      "name": "web_fetch",
      "description": "Webページの内容を取得",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    {
      "name": "document_parser",
      "description": "ドキュメントを解析",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "required": true
          },
          "format": {
            "type": "string",
            "required": false
          }
        }
      }
    },
    {
      "name": "execute",
      "description": "タスクを実行",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "タスクID"
          },
          "action": {
            "type": "string",
            "description": "アクション名"
          },
          "parameters": {
            "type": "object",
            "description": "パラメータ"
          }
        }
      }
    }
  ],
  "calls": [
    {
      "call": {
        "name": "execute",
        "arguments": {
          "task_id": "g-1",
