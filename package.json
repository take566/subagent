{
  "name": "subagent",
  "version": "1.0.0",
  "description": "Subagent system for task delegation and parallel processing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "mcp:research": "node dist/mcp/research-server.js",
    "mcp:codegen": "node dist/mcp/codegen-server.js",
    "mcp:review": "node dist/mcp/review-server.js",
    "mcp:document": "node dist/mcp/document-server.js",
    "example": "tsx examples/basic-usage.ts"
  },
  "keywords": [
    "agent",
    "subagent",
    "orchestration",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}

